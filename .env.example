# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env — it is git-ignored.
# ---------------------------------------------------------------------------

# Required: the agent uses the OpenAI API to score jobs and write documents.
OPENAI_API_KEY=
# Only for an OpenAI-compatible gateway; leave empty for OpenAI itself.
OPENAI_BASE_URL=

# Models. Run `jobsearch doctor` — it lists what your account can actually use
# and flags an id it does not recognise, rather than failing on the first run.
MODEL=gpt-5
# Optional cheaper model for scoring. Scoring runs on EVERY candidate job and
# dominates the bill, so a smaller model here is the biggest cost lever you
# have. Leave empty to use MODEL for both.
SCORING_MODEL=

# Reasoning effort: none | minimal | low | medium | high | xhigh | max
SCORING_EFFORT=low
WRITING_EFFORT=high

# ---------------------------------------------------------------------------
# How selective to be
# ---------------------------------------------------------------------------
# Fit score (0-100) a job must reach to enter your review queue.
MIN_SCORE=70
# Hard cap on documents written per day. Your main cost control.
MAX_NEW_APPLICATIONS_PER_DAY=15
MAX_JOBS_SCORED_PER_RUN=300

# ---------------------------------------------------------------------------
# Submission
# ---------------------------------------------------------------------------
# dry_run: build and record the exact request, send nothing. Start here.
# live:    actually submit to the ATS after you approve.
SUBMIT_MODE=dry_run
# When true, approving in the dashboard submits immediately.
AUTO_SUBMIT_ON_APPROVAL=true

# ---------------------------------------------------------------------------
# Schedule (5-field cron, in TIMEZONE)
# ---------------------------------------------------------------------------
DIGEST_CRON=0 8 * * *
TIMEZONE=UTC
RUN_ON_STARTUP=false

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
# Leave empty on a machine only you use. Set a random string to require
# ?token=... if the port is reachable by anyone else.
DASHBOARD_TOKEN=
# Used for links in the digest email.
PUBLIC_BASE_URL=http://localhost:8765

# ---------------------------------------------------------------------------
# Daily digest email (optional — the dashboard works without it)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=
DIGEST_TO=

# ---------------------------------------------------------------------------
# Optional source credentials (free tier at developer.adzuna.com)
# ---------------------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
